# Supabase project endpoint (Dashboard > Connect)
SUPABASE_URL=https://your-project-ref.supabase.co

# Browser-safe key. Row Level Security still controls its actual permissions.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only key. Never add a real value to source control or browser code.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Keep this true while confirming layouts. Set to false only when you are ready
# to enable real management writes after the database and permission review.
VISUAL_MODE=true
